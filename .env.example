# ------------------------------------------------------------------
# 3D Generation (Local Tencent Hunyuan3D service)
# ------------------------------------------------------------------
# The application generates 3D models using a LOCAL, open-source Tencent
# Hunyuan3D service. There is no cloud provider, no API key and no billing.
#
# Set up the local service first (see /hunyuan3d-service/README.md):
#   1. cd hunyuan3d-service
#   2. follow the setup instructions (clone Hunyuan3D-2, install deps)
#   3. python server.py            -> serves on http://127.0.0.1:8000
#
# Then just tell this app where to find it:

# Base URL of the local Hunyuan3D service.
HUNYUAN3D_URL=http://127.0.0.1:8000

# Optional timeout (ms) for a single Hunyuan3D generation/polling request.
# Defaults to 1800000 (30 minutes) - CPU generation is slow.
# HUNYUAN3D_TIMEOUT_MS=1800000

# Optional directory where generated GLB files are stored for the browser.
# Defaults to <project>/public/models (served at /models/<file>.glb).
# HUNYUAN3D_MODEL_OUTPUT_DIR=