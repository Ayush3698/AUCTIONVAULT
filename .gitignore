/hunyuan3d-service/.venv/
/hunyuan3d-service/outputs/
/hunyuan3d-service/Hunyuan3D-2/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts



# Dependencies and build output
node_modules/
.next/
out/
build/
dist/

# Environment secrets
.env
.env.*
!.env.example

# Temporary development files
*.log
dev-*.txt
.devpid
fetch_check.glb
taskid.txt
*.tsbuildinfo

# Python and Hunyuan3D local environment
__pycache__/
*.py[cod]
.venv/
venv/
hunyuan3d-service/outputs/
